{
  "mcpServers": {
    "HAPAtlas": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./scripts/runtime-bootstrap.ps1"
      ],
      "cwd": ".",
      "env_vars": [
        "OS",
        "PROCESSOR_ARCHITECTURE",
        "PROCESSOR_ARCHITEW6432",
        "WINDIR"
      ],
      "startup_timeout_sec": 300
    }
  }
}
