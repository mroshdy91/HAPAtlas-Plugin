{
  "name": "hapatlas",
  "version": "1.0.0-alpha.1-public.1",
  "description": "Workflow-gated HAPAtlas Alpha for licensed Carrier HAP, with automatic verified runtime installation.",
  "mcpServers": {
    "HAPAtlas": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${extensionPath}/scripts/runtime-bootstrap.ps1"
      ]
    }
  }
}
